[Unit]
Description=Borg Backup Integrity scheduled check (__APP__)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=LANG=C.UTF-8
ExecStart=/usr/local/bin/borg-backup-integrity-check run --scheduled --quiet
TimeoutStartSec=12h
Nice=10
IOSchedulingClass=idle
StandardOutput=append:/var/log/__APP__/__APP__.log
StandardError=inherit
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
NoNewPrivileges=no

# No [Install] section on purpose: the service is only started by its timer or manually.
